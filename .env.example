PORT=8787
HOST=127.0.0.1

# Generate with: node -e "console.log('cg_local_' + require('crypto').randomBytes(24).toString('hex'))"
GATEWAY_API_KEY=

LOG_LEVEL=info
DATABASE_URL=./data/gateway.db

# Defaults below come from spikes/FINDINGS.md's empirical concurrency test
# (N up to 6 succeeded with no errors on the tested account, but latency
# roughly doubled going from 3->4 concurrent requests) — not PRD's original
# placeholder value. Raise if your account/machine tolerates it; this is
# shared across BOTH compat routes and with your interactive Claude Code use.
MAX_CONCURRENT_REQUESTS=3
QUEUE_MAX_SIZE=10
REQUEST_TIMEOUT_MS=120000

CREDENTIAL_CHECK_INTERVAL_MS=60000

ENABLE_OPENAI_COMPAT_ROUTE=true
ENABLE_ANTHROPIC_COMPAT_ROUTE=true
